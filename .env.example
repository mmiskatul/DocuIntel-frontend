# DocuIntel website settings. Copy this file to ".env.local" (local) or set the same names in Vercel (production).
# These are read on the server only; none of them reaches the browser.

# Address of the backend API (no trailing slash).
BACKEND_URL=http://localhost:8000

# Must be the same value as API_KEY in the backend's .env. The built-in /api proxy adds it to every request,
# so it is never sent to the browser. Never prefix it with NEXT_PUBLIC_.
BACKEND_API_KEY=

# Do not set NEXT_PUBLIC_API_URL: the browser must talk to the built-in /api proxy, not to the backend directly.
