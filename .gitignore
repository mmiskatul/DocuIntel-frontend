# ==============================================================================
# DocuIntel Frontend .gitignore - Secrets, Credentials & Build Artifacts
# ==============================================================================

# 1. Environment & Secret Configuration (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Certificates, Private Keys & Tokens
*.pem
*.key
*.cert
*.crt
*.jwt
*.token
secrets.*
credentials.json
service-account*.json
client_secret*.json

# 3. Dependencies
node_modules/
.pnp
.pnp.js

# 4. Next.js & Build Output
.next/
.open-next/
.wrangler/
.dev.vars
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# 5. Testing & Coverage
coverage/
.vitest/

# 6. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. OS & IDE Configuration
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
